# Single source of truth for every upstream revision DSLink builds against. CI and scripts read this file;
# nothing is fetched from a floating "latest". Bump deliberately and update docs/UPSTREAM_VERSIONS.md.
RETROARCH_TAG=v1.22.2
RETROARCH_COMMIT=69a4f0ea1e8aaf442ae4858f2e7f2b31a1776576
MELONDS_DS_TAG=v1.4.0
MELONDS_DS_COMMIT=f394adbacb5722ee97c1b37c8064da9a25818310
# melonDS DS 1.4.0 fetches standalone melonDS from the *branch* jtg/fix-uninitialized-opengl (floating);
# DSLink pins the commit that branch pointed to when this version was qualified.
MELONDS_COMMIT=16f127dbb587a73371827ce79689c5d237c4b59b
# libopus: the Opus encoder of the Android Runtime (no FFmpeg there); built from this submodule by android-app/native/CMakeLists.txt.
OPUS_TAG=v1.5.2
OPUS_COMMIT=ddbe48383984d56acd9e1ab6a090c54ca6b735a6
# DSLink WebAssembly Runtime (PWA): Emscripten compiler + the emsdk revision that provides it (scripts/build_wasm.sh).
EMSCRIPTEN_TAG=3.1.74
EMSDK_COMMIT=b44154299bdefe75ba287874bb63fc9806243771
# PlaySphere PS1 (docs/PLAYSPHERE_PS1_CORE_DECISION.md): the PCSX-ReARMed libretro core, built for WebAssembly by scripts/build_ps1_wasm.sh. Vendored third party code (libchdr, libretro-common) is in the same tree.
PCSX_REARMED_REPO=https://github.com/libretro/pcsx_rearmed.git
PCSX_REARMED_COMMIT=c8816799b50388e61cfe237fe2cdbb7d8175f20a
